# Copy file này thành ".env" (cùng thư mục src/) rồi điền giá trị thật.
# File .env đã được liệt kê trong .gitignore nên sẽ không bị đẩy lên Git.

# Lấy tại: Supabase Dashboard -> chọn project -> Settings -> Database
# -> Connection string -> chọn tab "URI" -> copy phần "Session pooler" (port 5432)
POSTGREE_DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Dùng riêng cho môi trường testing nếu có project Supabase test riêng (không bắt buộc)
# TEST_POSTGREE_DATABASE_URL=postgresql://...

SECRET_KEY=doi-chuoi-nay-thanh-gia-tri-bi-mat-cua-ban
DEBUG=True
FLASK_ENV=development
